{
  "name": "apoji-admin",
  "productName": "Apoji Admin",
  "version": "2.0.0",
  "description": "The admin app for Nexus '28 and N28C.",
  "author": "Apoji Delegraphics",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "test": "node test/hub.test.js && node test/v18.test.js && node test/v19.test.js && node test/v20.test.js"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.apojidelegraphics.apojiadmin",
    "productName": "Apoji Admin",
    "copyright": "© 2026 Apoji Delegraphics. All rights reserved.",
    "artifactName": "Apoji-Admin-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "index.html",
      "admin.css",
      "admin.js",
      "crypto.js",
      "charts.js",
      "chat.js",
      "pages.js",
      "extras.js",
      "v18.js",
      "v19.js",
      "orb.js",
      "features.js",
      "sw.js",
      "manifest.webmanifest",
      "icons/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Apoji Admin ${version}",
      "background": "build/background.png",
      "iconSize": 112,
      "iconTextSize": 13,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 215,
          "type": "file"
        },
        {
          "x": 480,
          "y": 215,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
