{
  "name": "apoji-admin",
  "productName": "Apoji Admin",
  "version": "3.0.0",
  "description": "The admin app for Nexus '28 and N28C, for Mac and Windows.",
  "author": "Apoji Delegraphics",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/postinstall.js",
    "build:brightness": "sh scripts/build-brightness.sh",
    "dist": "electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "test": "node test/hub.test.js && node test/v18.test.js && node test/v19.test.js && node test/v20.test.js && node test/v202.test.js && node test/v203.test.js && node test/v204.test.js && node test/v205.test.js && node test/v21.test.js && node test/v22.test.js && node test/v23.test.js && node test/v24.test.js && node test/v25.test.js && node test/v26.test.js && node test/v27.test.js && node test/v28.test.js && node test/v281.test.js && node test/v29.test.js && node test/v210.test.js && node test/v30.test.js",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "qrcode": "1.5.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.apojidelegraphics.apojiadmin",
    "productName": "Apoji Admin",
    "copyright": "© 2026 Apoji Delegraphics. All rights reserved.",
    "artifactName": "Apoji-Admin-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "build/icon.png",
      "index.html",
      "admin.css",
      "admin.js",
      "crypto.js",
      "charts.js",
      "chat.js",
      "pages.js",
      "extras.js",
      "v18.js",
      "v19.js",
      "v2*.js",
      "mindtree.js",
      "terms-data.js",
      "icons.js",
      "cosmetics.js",
      "fonts/**",
      "orb.js",
      "features.js",
      "sw.js",
      "manifest.webmanifest",
      "icons/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "extraResources": [
        {
          "from": "bin/",
          "to": "bin/",
          "filter": [
            "apoji-brightness"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Apoji Admin ${version}",
      "background": "build/background.png",
      "iconSize": 112,
      "iconTextSize": 13,
      "window": {
        "width": 660,
        "height": 420
      },
      "contents": [
        {
          "x": 180,
          "y": 215,
          "type": "file"
        },
        {
          "x": 480,
          "y": 215,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Apoji-Admin-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Apoji Admin",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "apojidelegraphics",
        "repo": "Apoji-Admin"
      }
    ]
  }
}
